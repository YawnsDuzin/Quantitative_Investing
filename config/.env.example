# API Keys and Credentials
# Copy this file to .env and fill in your actual credentials

# Alpha Vantage API (for US stock data)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# Polygon.io API (alternative for US stock data)
POLYGON_API_KEY=your_polygon_api_key_here

# Telegram Bot (for notifications)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Email Notifications
EMAIL_SENDER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here
EMAIL_RECEIVER=receiver_email@gmail.com

# Database Credentials (if using PostgreSQL/MySQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=quant_investing
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# KIS API (한국투자증권 - for real trading, optional)
KIS_APP_KEY=your_kis_app_key_here
KIS_APP_SECRET=your_kis_app_secret_here
KIS_ACCOUNT_NUMBER=your_account_number_here

# Interactive Brokers (for US trading, optional)
IB_ACCOUNT=your_ib_account_here
IB_USERNAME=your_ib_username_here
IB_PASSWORD=your_ib_password_here
